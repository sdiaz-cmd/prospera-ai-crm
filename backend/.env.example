# ============================================
# PROSPERA.AI — Variables de Entorno
# ============================================
# Copia este archivo como .env y ajusta los valores

# ─── Servidor ────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── JWT ─────────────────────────────────────────────────────────
# Genera secretos con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=tu_jwt_secret_super_seguro_cambia_esto_en_produccion_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=tu_refresh_secret_super_seguro_cambia_esto_en_produccion_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# ─── Base de datos ────────────────────────────────────────────────
# Dev: dejar vacío (usa ruta por defecto ./prospera.db)
# Producción Railway: /data/prospera.db
DB_PATH=

# ─── Email (Resend) ───────────────────────────────────────────────
# Crea cuenta en resend.com → API Keys → Create API Key
# En DEV: si está vacío, el link de reset se imprime en consola del backend
RESEND_API_KEY=
RESEND_FROM=PROSPERA.AI <noreply@tudominio.com>

# ─── URLs ────────────────────────────────────────────────────────
# URL del frontend (para los links en emails)
APP_URL=http://localhost:5173

# ─── CORS ────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
